      <bt:LongStrings>
        <bt:String id="Tip.Sheet" DefaultValue="Datenblatt öffnen: Werte wie in Excel eintragen oder per ⌘V aus Excel einfügen. Ein ausgewähltes Diagramm wird automatisch geladen."/>
        <bt:String id="GetStarted.Description" DefaultValue="Im Reiter Chartwerk ein Diagramm einfügen und über Datenblatt die Werte ändern."/>
        <bt:String id="Tip.Stacked" DefaultValue="Gestapelte Säulen mit Summen, Reihenbeschriftung rechts und CAGR-Pfeil. Daten danach im Datenblatt anpassen."/>
        <bt:String id="Tip.Clustered" DefaultValue="Gruppierte Säulen für Vergleiche, zum Beispiel Plan und Ist."/>
        <bt:String id="Tip.Percent" DefaultValue="100-%-Säulen für Anteile und Strukturen."/>
        <bt:String id="Tip.Bar" DefaultValue="Horizontale Balken, ideal für Rankings."/>
        <bt:String id="Tip.Waterfall" DefaultValue="Brücke vom Start- zum Endwert, etwa eine EBIT-Bridge. Ein e im Datenblatt erzeugt Summen."/>
        <bt:String id="Tip.Line" DefaultValue="Liniendiagramm für Zeitreihen mit Beschriftung am Linienende."/>
        <bt:String id="Tip.Mekko" DefaultValue="Marimekko: Spaltenbreite nach Größe, Segmente nach Anteil, zum Beispiel für Marktkarten."/>
        <bt:String id="Tip.Refresh" DefaultValue="Ausgewähltes Diagramm an seine aktuelle Größe anpassen und Beschriftungen und Pfeile neu anordnen."/>
        <bt:String id="Tip.Cagr" DefaultValue="CAGR-Pfeil von der ersten zur letzten Säule ein- oder ausblenden."/>
        <bt:String id="Tip.Diff" DefaultValue="Differenzpfeil zwischen den letzten beiden Säulen ein- oder ausblenden (Wasserfall: Start bis Ende)."/>
        <bt:String id="Tip.Level" DefaultValue="Niveaupfeil zwischen erster und letzter Säule ein- oder ausblenden."/>
      </bt:LongStrings>
